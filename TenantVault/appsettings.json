{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cosmos": {
    "AccountEndpoint": "https://<your-cosmos-account>://",
    "AccountKey": "<your-primary-or-secondary-key>",
    "DatabaseName": "Inventory",
    "ContainerName": "Vehicles",
    "PartitionKeyPaths": [ "/tenantId", "/vehicleId" ],
    "Throughput": 1000,
    "UseAutoScale": true
  }
}
